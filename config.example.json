{
  "muse": {
    "cookies_file": "cookies.json",
    "session_id": "YOUR_MUSE_SESSION_ID",
    "approval": {
      "mode": "manual",
      "notify": true
    }
  },
  "adapters": {
    "qq": {
      "enabled": true,
      "app_id": "YOUR_QQ_APP_ID",
      "app_secret": "YOUR_QQ_APP_SECRET",
