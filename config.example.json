      },
      "delivered_file": "data/qq_delivered.jsonl",
      "session_map_file": "data/qq_session_map.json",
      "session_bindings": {},
      "push_state_file": "data/qq_push_state.json",
      "catch_up_enabled": false,
      "allow_all_private": false,
      "allow_all_group": false,
      "whitelist": {
        "private": [
          "YOUR_C2C_OPENID"
        ],
        "YOUR_GROUP_OPENID": "*"
      }
    },
    "onebot": {
      "enabled": false,
      "base_url": "https://onebot.example.com",
      "access_token": "YOUR_ONEBOT_TOKEN",
      "ws_url": "wss://onebot.example.com",
      "admin_id": [
        "YOUR_ADMIN_QQ"
      ],
      "admin_only": true,
      "unbound_push_to_admin": true,
      "approvals_in_place": true,
      "group_trigger": "all",
      "access_requests": {
        "enabled": true,
        "auto_approve": false,
        "state_file": "data/onebot_access.local.json"
      },
      "delivered_file": "data/onebot_delivered.jsonl",
      "session_map_file": "data/onebot_session_map.json",
      "push_state_file": "data/onebot_push_state.json",
      "routes_file": "data/onebot_routes.json",
      "allow_all_private": false,
      "allow_all_group": false,
      "whitelist": {
        "private": [
          "YOUR_ADMIN_QQ"
        ],
        "YOUR_GROUP_ID": "*"
      }
    },
    "wechat": {
      "enabled": false,
      "state_dir": "data/wechat",
      "channel_version": "2.4.6",
      "route_tag": "",
      "http_timeout_s": 35,
      "polling_timeout_ms": 35000,
      "reconnect_max_retries": 30,
      "typing_enabled": false,
      "chunk_chars": 4000,
      "max_chunks": 8,
      "session_bindings": {}
    }
