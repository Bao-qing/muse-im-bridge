  "logging": {
    "level": "INFO",
    "console": true,
    "file": "logs/bridge.log",
    "trace": false,
    "trace_file": "logs/trace.jsonl",
    "payload_limit": 65536,
    "max_bytes": 10485760,
    "backup_count": 5
